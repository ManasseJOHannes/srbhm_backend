generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         Int      @id @default(autoincrement())
  imatricule String   @unique
  nom        String
  prenom     String
  cin        String   @unique
  telephone  String   @unique
  role       Role     @default(DEPOSITEUR_COMPTABLE)
  adresse    String
  email      String?  @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  password   String
  soaId      Int
  soa        SOA      @relation(fields: [soaId], references: [id])
}

model UserRequest {
  id              Int           @id @default(autoincrement())
  imatricule      String
  nom             String
  prenom          String
  cin             String
  telephone       String
  adresse         String
  email           String?
  status          RequestStatus @default(PENDING)
  createdAt       DateTime      @default(now())
  updateAt        DateTime      @updatedAt
  role            Role
  rejectionReason String?
  soaId           Int
  soa             SOA           @relation(fields: [soaId], references: [id])
}

model SOA {
  id           Int           @id @default(autoincrement())
  code         String        @unique
  libelle      String
  description  String?
  actif        Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  exercices    Exercice[]
  users        User[]
  userRequests UserRequest[]

  @@map("soas")
}

model Exercice {
  id            Int            @id @default(autoincrement())
  annee         Int
  dateDebut     DateTime
  dateFin       DateTime
  statut        StatutExercice @default(EN_COURS)
  soaId         Int
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  soa           SOA            @relation(fields: [soaId], references: [id])

  @@unique([soaId, annee])
  @@index([soaId])
  @@index([statut])
}

enum Role {
  ADMIN
  ORDONNATEUR
  COMPTABLE
  DEPOSITEUR_COMPTABLE @map("DEPOSITEUR-COMPTABLE")
  USER
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum StatutExercice {
  EN_COURS
  CLOTURE
}
