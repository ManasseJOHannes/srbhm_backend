
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         Int      @id @default(autoincrement())
  imatricule String   @unique
  nom        String
  prenom     String
  cin        String   @unique
  telephone  String   @unique
  soaId      Int
  soa        SOA      @relation(fields: [soaId], references: [id])
  role       Role     @default(DEPOSITEUR_COMPTABLE)
  adresse    String
  email      String?  @unique
  password   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model UserRequest {
  id         Int     @id @default(autoincrement())
  imatricule String
  nom        String
  prenom     String
  cin        String
  telephone  String
  soaId      Int
  soa        SOA     @relation(fields: [soaId], references: [id])
  role       Role
  adresse    String
  email      String?

  status          RequestStatus @default(PENDING)
  rejectionReason String?

  createdAt DateTime @default(now())
  updateAt  DateTime @updatedAt
}

enum Role {
  ADMIN
  ORDONNATEUR
  COMPTABLE
  DEPOSITEUR_COMPTABLE @map("DEPOSITEUR-COMPTABLE")
  USER
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model SOA {
  id          Int     @id @default(autoincrement())
  code        String  @unique
  libelle     String
  description String?
  actif       Boolean @default(true)

  users        User[]
  userRequests UserRequest[]
  exercices    Exercice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("soas")
}

enum StatutExercice {
  EN_COURS
  CLOTURE
}

model Exercice {
  id        Int            @id @default(autoincrement())
  annee     Int
  dateDebut DateTime
  dateFin   DateTime
  statut    StatutExercice @default(EN_COURS)

  soaId     Int
  soa       SOA            @relation(fields: [soaId], references: [id])

  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([soaId, annee])
  @@index([soaId])
  @@index([statut])
}
