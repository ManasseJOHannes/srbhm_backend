generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         Int      @id @default(autoincrement())
  imatricule String   @unique
  nom        String
  prenom     String
  cin        String   @unique
  telephone  String   @unique
  role       Role     @default(DEPOSITEUR_COMPTABLE)
  adresse    String
  email      String?  @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  password   String
  soaId      Int
  soa        SOA      @relation(fields: [soaId], references: [id])

  /// Incrémenté à chaque changement de mot de passe ou réinitialisation.
  /// Copié dans le JWT à la connexion puis comparé à chaque requête :
  /// un écart invalide tous les jetons émis auparavant (déconnexion forcée).
  tokenVersion Int                  @default(0)
  resetTokens  PasswordResetToken[]
}

/// Jeton de réinitialisation de mot de passe, à usage unique et expirant.
///
/// Seul le SHA-256 du jeton est stocké : la base ne contient jamais le
/// jeton utilisable. Si la base fuite, les liens de reset sont inutilisables.
model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model UserRequest {
  id              Int           @id @default(autoincrement())
  imatricule      String
  nom             String
  prenom          String
  cin             String
  telephone       String
  adresse         String
  email           String?
  status          RequestStatus @default(PENDING)
  createdAt       DateTime      @default(now())
  updateAt        DateTime      @updatedAt
  role            Role
  rejectionReason String?
  soaId           Int
  soa             SOA           @relation(fields: [soaId], references: [id])
}

model SOA {
  id           Int           @id @default(autoincrement())
  code         String        @unique
  libelle      String
  description  String?
  /// Localité imprimée sur l'en-tête officiel de l'inventaire (« Hôtel du (2) »).
  localite     String?
  actif        Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  exercices    Exercice[]
  users        User[]
  userRequests UserRequest[]

  @@map("soas")
}

model Exercice {
  id            Int            @id @default(autoincrement())
  annee         Int
  dateDebut     DateTime
  dateFin       DateTime
  statut        StatutExercice @default(EN_COURS)
  soaId         Int
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  soa           SOA            @relation(fields: [soaId], references: [id])
  compteMatiere CompteMatiere?
  inventaire    Inventaire?
  mouvements    Mouvement[]

  @@unique([soaId, annee])
  @@index([soaId])
  @@index([statut])
}

model Nomenclature {
  id          Int          @id @default(autoincrement())
  code        String       @unique
  libelle     String
  description String?
  actif       Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  articles    Article[]
  paragraphes Paragraphe[]
}

/// Chapitre budgétaire (2 chiffres, ex. 21).
model Chapitre {
  id       Int           @id @default(autoincrement())
  chapitre String        @unique
  articles CodeArticle[]
}

/// Article budgétaire (3 chiffres, ex. 216), rattaché à un chapitre.
model CodeArticle {
  id          Int          @id @default(autoincrement())
  chapitreId  Int
  chapitre    Chapitre     @relation(fields: [chapitreId], references: [id])
  article     String
  libelle     String?
  paragraphes Paragraphe[]

  @@unique([chapitreId, article])
  @@index([chapitreId])
}

/// Paragraphe / code compte (4 chiffres, ex. 2164). Porte l'association
/// facultative avec une nomenclature métier.
model Paragraphe {
  id             Int           @id @default(autoincrement())
  articleId      Int
  article        CodeArticle   @relation(fields: [articleId], references: [id])
  code           String        @unique
  libelle        String
  nomenclatureId Int?
  nomenclature   Nomenclature? @relation(fields: [nomenclatureId], references: [id], onDelete: SetNull)
  articles       Article[]

  @@index([articleId])
  @@index([nomenclatureId])
}

model Article {
  id               Int                   @id @default(autoincrement())
  designation      String
  unite            String
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  nomenclatureId   Int
  nomenclature     Nomenclature          @relation(fields: [nomenclatureId], references: [id])
  paragrapheId     Int
  paragraphe       Paragraphe            @relation(fields: [paragrapheId], references: [id])
  details          DetailCompteMatiere[]
  lignesInventaire LigneInventaire[]
  mouvements       Mouvement[]

  @@index([nomenclatureId])
  @@index([paragrapheId])
}

model CompteMatiere {
  id                   Int                   @id @default(autoincrement())
  exerciceId           Int                   @unique
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  valeurExistanteDebut Decimal               @default(0)
  valeurEntrees        Decimal               @default(0)
  valeurSorties        Decimal               @default(0)
  valeurRestante       Decimal               @default(0)
  exercice             Exercice              @relation(fields: [exerciceId], references: [id])
  details              DetailCompteMatiere[]
}

model DetailCompteMatiere {
  id              Int           @id @default(autoincrement())
  compteMatiereId Int
  articleId       Int
  folioGrandLivre Int?
  prixUnitaire    Decimal
  existantDebut   Decimal       @default(0)
  entrees         Decimal       @default(0)
  sorties         Decimal       @default(0)
  observation     String?
  observationEtat String        @default("Bon état")
  /// Détail créé par un excédent de recensement, supprimable lorsqu'il redevient vide.
  creeParRecensement Boolean    @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  article         Article       @relation(fields: [articleId], references: [id])
  compteMatiere   CompteMatiere @relation(fields: [compteMatiereId], references: [id])

  @@unique([compteMatiereId, articleId, prixUnitaire])
  @@index([compteMatiereId])
  @@index([articleId])
}

model Mouvement {
  id                Int              @id @default(autoincrement())
  type              TypeMouvement
  date              DateTime
  exerciceId        Int
  articleId         Int
  quantite          Decimal
  prixUnitaire      Decimal
  observation       String?
  origine           OrigineMouvement @default(MANUEL)
  ligneInventaireId Int?             @unique
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  article           Article          @relation(fields: [articleId], references: [id])
  exercice          Exercice         @relation(fields: [exerciceId], references: [id])
  ligneInventaire   LigneInventaire? @relation(fields: [ligneInventaireId], references: [id], onDelete: Cascade)

  @@index([exerciceId])
  @@index([articleId])
  @@index([type])
  @@index([date])
}

model Inventaire {
  id             Int               @id @default(autoincrement())
  exerciceId     Int               @unique
  dateInventaire DateTime
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  exercice       Exercice          @relation(fields: [exerciceId], references: [id])
  lignes         LigneInventaire[]
}

model LigneInventaire {
  id                Int        @id @default(autoincrement())
  inventaireId      Int
  articleId         Int
  prixUnitaire      Decimal
  quantitePhysique  Decimal    @db.Decimal(12, 2)
  quantiteExcedent  Decimal?   @db.Decimal(12, 2)
  quantiteDeficit   Decimal?   @db.Decimal(12, 2)
  /// Existant figé avant les ajustements créés par le recensement.
  existantReference Decimal?   @db.Decimal(12, 2)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  inventaire        Inventaire @relation(fields: [inventaireId], references: [id])
  article           Article    @relation(fields: [articleId], references: [id])
  mouvement         Mouvement?

  @@unique([inventaireId, articleId, prixUnitaire])
  @@index([inventaireId])
  @@index([articleId])
}

enum Role {
  ADMIN
  ORDONNATEUR
  COMPTABLE
  DEPOSITEUR_COMPTABLE @map("DEPOSITEUR-COMPTABLE")
  USER
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum StatutExercice {
  EN_COURS
  CLOTURE
}

enum TypeMouvement {
  ENTREE
  SORTIE
}

enum OrigineMouvement {
  MANUEL
  RECENSEMENT
}
