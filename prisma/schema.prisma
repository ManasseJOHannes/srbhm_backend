generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         Int      @id @default(autoincrement())
  imatricule String   @unique
  nom        String
  prenom     String
  cin        String   @unique
  telephone  String   @unique
  role       Role     @default(DEPOSITEUR_COMPTABLE)
  adresse    String
  email      String?  @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  password   String
  soaId      Int
  soa        SOA      @relation(fields: [soaId], references: [id])
}

model UserRequest {
  id              Int           @id @default(autoincrement())
  imatricule      String
  nom             String
  prenom          String
  cin             String
  telephone       String
  adresse         String
  email           String?
  status          RequestStatus @default(PENDING)
  createdAt       DateTime      @default(now())
  updateAt        DateTime      @updatedAt
  role            Role
  rejectionReason String?
  soaId           Int
  soa             SOA           @relation(fields: [soaId], references: [id])
}

model SOA {
  id           Int           @id @default(autoincrement())
  code         String        @unique
  libelle      String
  description  String?
  actif        Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  exercices    Exercice[]
  users        User[]
  userRequests UserRequest[]

  @@map("soas")
}

model Exercice {
  id            Int            @id @default(autoincrement())
  annee         Int
  dateDebut     DateTime
  dateFin       DateTime
  statut        StatutExercice @default(EN_COURS)
  soaId         Int
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  compteMatiere CompteMatiere?
  inventaire    Inventaire?
  soa           SOA            @relation(fields: [soaId], references: [id])
  lotsStock     LotStock[]
  mouvements    Mouvement[]

  @@unique([soaId, annee])
  @@index([soaId])
  @@index([statut])
}

model Nomenclature {
  id          Int       @id @default(autoincrement())
  code        String    @unique
  libelle     String
  description String?
  actif       Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  articles    Article[]
}

model Article {
  id             Int                   @id @default(autoincrement())
  designation    String
  unite          String
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  nomenclatureId Int
  nomenclature   Nomenclature          @relation(fields: [nomenclatureId], references: [id])
  details        DetailCompteMatiere[]
  lignesInventaire LigneInventaire[]
  lotsStock      LotStock[]
  mouvements     Mouvement[]

  @@index([nomenclatureId])
}

model CompteMatiere {
  id                   Int                   @id @default(autoincrement())
  exerciceId           Int                   @unique
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  valeurEntrees        Decimal               @default(0)
  valeurExistanteDebut Decimal               @default(0)
  valeurRestante       Decimal               @default(0)
  valeurSorties        Decimal               @default(0)
  exercice             Exercice              @relation(fields: [exerciceId], references: [id])
  details              DetailCompteMatiere[]
}

model DetailCompteMatiere {
  id              Int           @id @default(autoincrement())
  compteMatiereId Int
  articleId       Int
  folioGrandLivre Int?
  prixUnitaire    Decimal
  existantDebut   Decimal       @default(0)
  entrees         Decimal       @default(0)
  sorties         Decimal       @default(0)
  observation     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  article         Article       @relation(fields: [articleId], references: [id])
  compteMatiere   CompteMatiere @relation(fields: [compteMatiereId], references: [id])
  lotStockInitial LotStock?     @relation("DetailStockInitial")

  @@unique([compteMatiereId, articleId, prixUnitaire])
  @@index([compteMatiereId])
  @@index([articleId])
}

model Mouvement {
  id                 Int                 @id @default(autoincrement())
  type               TypeMouvement
  date               DateTime
  exerciceId         Int
  articleId          Int
  quantite           Decimal
  prixUnitaire       Decimal
  observation        String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  affectationsSortie AffectationSortie[] @relation("SortieAffectations")
  lotStockCree       LotStock?           @relation("MouvementEntreeLot")
  article            Article             @relation(fields: [articleId], references: [id])
  exercice           Exercice            @relation(fields: [exerciceId], references: [id])

  @@index([exerciceId])
  @@index([articleId])
  @@index([type])
  @@index([date])
}

model AffectationSortie {
  id                Int       @id @default(autoincrement())
  mouvementSortieId Int
  lotStockId        Int
  quantite          Decimal   @db.Decimal(12, 2)
  createdAt         DateTime  @default(now())
  lotStock          LotStock  @relation(fields: [lotStockId], references: [id])
  mouvementSortie   Mouvement @relation("SortieAffectations", fields: [mouvementSortieId], references: [id])

  @@index([mouvementSortieId])
  @@index([lotStockId])
}

model LotStock {
  id                    Int                  @id @default(autoincrement())
  articleId             Int
  exerciceId            Int
  typeOrigine           TypeOrigineLot
  mouvementEntreeId     Int?                 @unique
  detailCompteMatiereId Int?                 @unique
  dateOrigine           DateTime
  quantiteInitiale      Decimal              @db.Decimal(12, 2)
  quantiteRestante      Decimal              @db.Decimal(12, 2)
  prixUnitaire          Decimal              @db.Decimal(12, 2)
  lotParentId           Int?
  observation           String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  affectations          AffectationSortie[]
  article               Article              @relation(fields: [articleId], references: [id])
  detailCompteMatiere   DetailCompteMatiere? @relation("DetailStockInitial", fields: [detailCompteMatiereId], references: [id], onDelete: Restrict)
  exercice              Exercice             @relation(fields: [exerciceId], references: [id])
  lotParent             LotStock?            @relation("LotTransfert", fields: [lotParentId], references: [id], onDelete: Restrict)
  lotsEnfants           LotStock[]           @relation("LotTransfert")
  mouvementEntree       Mouvement?           @relation("MouvementEntreeLot", fields: [mouvementEntreeId], references: [id], onDelete: Restrict)
  observations          ObservationStock[]

  @@index([articleId, dateOrigine, id])
  @@index([exerciceId])
  @@index([mouvementEntreeId])
  @@index([detailCompteMatiereId])
  @@index([lotParentId])
}

model ObservationStock {
  id         Int       @id @default(autoincrement())
  lotStockId Int
  texte      String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lotStock   LotStock  @relation(fields: [lotStockId], references: [id], onDelete: Restrict)

  @@index([lotStockId])
}

model Inventaire {
  id             Int                @id @default(autoincrement())
  exerciceId     Int                @unique
  dateInventaire DateTime
  lieu           String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  exercice       Exercice           @relation(fields: [exerciceId], references: [id], onDelete: Restrict)
  lignes         LigneInventaire[]
}

model LigneInventaire {
  id                Int        @id @default(autoincrement())
  inventaireId      Int
  articleId         Int
  prixUnitaire      Decimal    @db.Decimal(12, 2)
  quantitePhysique  Decimal    @db.Decimal(12, 2)
  observation       String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  inventaire        Inventaire @relation(fields: [inventaireId], references: [id], onDelete: Restrict)
  article           Article    @relation(fields: [articleId], references: [id], onDelete: Restrict)

  @@unique([inventaireId, articleId, prixUnitaire])
  @@index([inventaireId])
  @@index([articleId])
}

enum Role {
  ADMIN
  ORDONNATEUR
  COMPTABLE
  DEPOSITEUR_COMPTABLE @map("DEPOSITEUR-COMPTABLE")
  USER
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum StatutExercice {
  EN_COURS
  CLOTURE
}

enum TypeMouvement {
  ENTREE
  SORTIE
}

enum TypeOrigineLot {
  STOCK_INITIAL
  ENTREE
}
